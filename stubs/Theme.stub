<?php

namespace {{ namespace }};

use Filament\Panel;
use KennethTomagan\FilamentThemes\Contracts\CanModifyPanelConfig;
use KennethTomagan\FilamentThemes\Contracts\Theme;

class {{ class }} implements CanModifyPanelConfig, Theme
{
    public static function getName(): string
    {
        return '{{ name }}';
    }

    public static function getPath(): string
    {
        return 'resources/css/filament/{{ panel }}/themes/{{ name }}.css';
    }

    public function getThemeColor(): array
    {
        return [
            'primary' => '#ffffff',
        ];
    }

    public function modifyPanelConfig(Panel $panel): Panel
    {
        return $panel
            ->{{ method }}($this->getPath());
    }
}
